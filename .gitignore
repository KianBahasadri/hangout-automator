# .env holds live secrets. The variant patterns matter: a plain ".env" line
# leaves .env.bak, .env.local, .env.prod and friends committable, which is
# exactly the shape a hurried backup takes.
.env
.env.*
!.env.example
.venv/
.venv-box/
venv/
__pycache__/
*.egg-info/
*.py[cod]
*.db
*.db-*
hangout.db
logs/
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
*.tfstate
*.tfstate.*
.terraform/
terraform/terraform.tfvars
terraform/backend.hcl
terraform/backend.tf
*.pem
.DS_Store
.commandcode/
