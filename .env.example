# Copy this ignored template to `.env.development` for local work. Production
# Terraform/deploy settings belong only in the separately ignored `.env.production`.
# `HANGOUT_ENV` defaults to `development`; use `HANGOUT_ENV=production` only for
# an explicit production process.

# App
APP_HOST=0.0.0.0
APP_PORT=8000
# Local Postgres from docker-compose.yml (start it with scripts/db_up.sh).
# Deployments override this with the Azure Flexible Server connection string.
DATABASE_URL=postgresql+psycopg://hangout:hangout@localhost:5432/hangout
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Clerk authentication is explicit opt-in. When enabled, the app requires a
# verified Clerk session for its UI/API while the SMS webhook stays public for
# Twilio signature validation. Development uses a pk_test_/sk_test_ pair and
# its *.accounts.dev Frontend API; production uses a separate pk_live_/sk_live_
# pair and production Frontend API. Never mix those pairs between env files.
CLERK_ENABLED=false
CLERK_PUBLISHABLE_KEY=
CLERK_FRONTEND_API_URL=
CLERK_SECRET_KEY=
# Optional PEM public key for networkless verification instead of the secret key.
CLERK_JWT_KEY=
# Comma-separated app origins, e.g. http://127.0.0.1:8000,https://app.example.com.
# Blank falls back to PUBLIC_BASE_URL.
CLERK_AUTHORIZED_PARTIES=
# Deploy-only. A Clerk *production* instance serves its Frontend API from a
# subdomain of the app's hostname and needs five CNAMEs in the zone; Terraform
# creates them when this is set. It is the instance-specific label in Clerk's
# mail/DKIM targets — the <id> in mail.<id>.clerk.services, shown with the DNS
# records in the Clerk Dashboard. Leave empty on a development instance.
CLERK_DNS_ID=

# Comma-separated emails that always hold an `admin` access grant. A Clerk
# account only reaches the app if its verified email is on the access list
# (Settings → Access); admins are the ones who can edit that list. Applied at
# startup, additive only, so it is also the way back in after a lockout.
# Required with CLERK_ENABLED=true — an empty list and an empty table means
# nobody can sign in.
ACCESS_BOOTSTRAP_ADMINS=

# Interactive OpenAPI UI at /docs. When Clerk is enabled this is protected too.
ENABLE_API_DOCS=true

# Structured JSONL event log. Local logs stay under logs/; production points
# this at the persistent data disk. Bodies and headers are intentionally
# verbose for traceability; sensitive auth/cookie headers remain redacted.
LOG_FILE=logs/server.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=50000000
LOG_BACKUP_COUNT=10
LOG_BODY_MAX_BYTES=262144

# SMS: set SMS_PROVIDER=mock for local dev (logs messages, no real sends)
# Set SMS_PROVIDER=twilio and fill Twilio vars for production
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Google Maps Platform Places API (New) key. When set, the new
# hangout Location field offers Google address/place autocomplete; blank keeps
# the existing free-text behavior.
GOOGLE_MAPS_API_KEY=

# Follow-ups: hours after initial invite (comma-separated, max 2 used)
FOLLOWUP_HOURS=24,48

# Organizer interval notifications default (hours) when a hangout
# enables digests but you want an app-level fallback cadence.
# Per-hangout "How often" on the create form overrides this for that hangout.
ORGANIZER_INTERVAL_HOURS=6

# Production Postgres (Azure Flexible Server). scripts/deploy/terraform.sh
# requires this in `.env.production`; the app reads DATABASE_URL from the
# rendered production environment file. No default in Terraform.
# POSTGRES_ADMIN_PASSWORD=
