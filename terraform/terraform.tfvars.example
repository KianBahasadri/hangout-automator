# Optional reference values for a local terraform.tfvars. The wrapper can use
# the ignored .env and the active Azure CLI without this file.

# Region and size are constrained by subscription policy and capacity, not
# preference. See docs/deploy.md "Region and VM size capacity" before editing.
prefix   = "hangout"
location = "mexicocentral"
vm_size  = "Standard_B2ats_v2"
data_disk_size_gb = 32

# Account and zone IDs are 32-char hex values from the Cloudflare dashboard.
# The wrapper normally reads them from the ignored .env instead.
cloudflare_account_id  = "00000000000000000000000000000000"
cloudflare_zone_id     = "00000000000000000000000000000000"
cloudflare_hostname    = "hangout.example.com"
cloudflare_tunnel_name = "hangout-automator"

# Cloudflare Access is the only authentication in front of the app. The wrapper
# builds this from the comma-separated CLOUDFLARE_ACCESS_EMAILS in .env.
cloudflare_access_allowed_emails = ["you@example.com"]

admin_username = "hangout"
ssh_public_key = "ssh-ed25519 AAAA... your-key"

# Deploy from git on first boot.
git_repo_url = "https://github.com/KianBahasadri/hangout-automator.git"
git_branch   = "main"
# Optional immutable commit SHA for reproducible releases.
# git_revision = "0123456789abcdef0123456789abcdef01234567"

# SMS
sms_provider       = "mock"
twilio_account_sid = ""
twilio_auth_token  = ""
twilio_from_number = ""

# Canonical public URL for Twilio signatures. Defaults to https://<cloudflare_hostname>.
# public_base_url = "https://hangout.example.com"
