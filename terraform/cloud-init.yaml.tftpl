#cloud-config
package_update: true
packages:
  - python3
  - python3-venv
  - python3-pip
  - git
  - curl

write_files:
  - path: /etc/hangout-automator.env
    owner: root:root
    permissions: "0600"
    content: |
      HANGOUT_ENV=production
      APP_HOST=127.0.0.1
      APP_PORT=${app_port}
      # Azure Flexible Server, reached via private endpoint + private DNS zone.
      DATABASE_URL=postgresql+psycopg://${postgres_admin_user}:${postgres_admin_password}@${postgres_host}/hangout
      LOG_FILE=/var/lib/hangout-automator/logs/server.log
      LOG_LEVEL=INFO
      LOG_MAX_BYTES=50000000
      LOG_BACKUP_COUNT=10
      LOG_BODY_MAX_BYTES=262144
      PUBLIC_BASE_URL=${public_base_url}
      ENABLE_API_DOCS=false
      SMS_PROVIDER=${sms_provider}
      TWILIO_ACCOUNT_SID=${twilio_account_sid}
      TWILIO_AUTH_TOKEN=${twilio_auth_token}
      TWILIO_FROM_NUMBER=${twilio_from_number}
      GOOGLE_MAPS_API_KEY=${google_maps_api_key}
      CLERK_ENABLED=${clerk_enabled}
      CLERK_PUBLISHABLE_KEY=${clerk_publishable_key}
      CLERK_FRONTEND_API_URL=${clerk_frontend_api_url}
      CLERK_SECRET_KEY=${clerk_secret_key}
      CLERK_JWT_KEY=${clerk_jwt_key}
      CLERK_AUTHORIZED_PARTIES=${clerk_authorized_parties}
      ACCESS_BOOTSTRAP_ADMINS=${access_bootstrap_admins}
      FOLLOWUP_HOURS=${followup_hours}
      ORGANIZER_INTERVAL_HOURS=${organizer_interval_hours}

  - path: /etc/systemd/system/hangout-automator.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Hangout Automator FastAPI
      After=network-online.target
      Wants=network-online.target
      # Audit logs live on the persistent data disk; fail loudly if it is not
      # mounted rather than losing the audit stream on the OS disk.
      RequiresMountsFor=/var/lib/hangout-automator

      [Service]
      Type=simple
      User=${admin_username}
      Group=${admin_username}
      WorkingDirectory=/opt/hangout-automator
      EnvironmentFile=/etc/hangout-automator.env
      ExecStart=/opt/hangout-automator/.venv/bin/python -m app.server
      Restart=always
      RestartSec=5
      UMask=0077
      NoNewPrivileges=true
      PrivateTmp=true

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/hangout-worker.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Hangout Automator background jobs
      After=network-online.target hangout-automator.service
      Wants=network-online.target

      [Service]
      Type=simple
      User=${admin_username}
      Group=${admin_username}
      WorkingDirectory=/opt/hangout-automator
      EnvironmentFile=/etc/hangout-automator.env
      ExecStart=/opt/hangout-automator/.venv/bin/python -m app.worker
      Restart=always
      RestartSec=5
      UMask=0077
      NoNewPrivileges=true
      PrivateTmp=true

      [Install]
      WantedBy=multi-user.target

  # Backups are off-site by Azure Database for PostgreSQL Flexible Server
  # itself (35-day backup retention, point-in-time restore) — the old
  # hangout-backup script/service/timer are gone.

  - path: /etc/cloudflared/token.env
    owner: root:root
    permissions: "0600"
    content: |
      TUNNEL_TOKEN=${cloudflare_tunnel_token}

  - path: /etc/systemd/system/cloudflared.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Cloudflare Tunnel for Hangout Automator
      After=network-online.target hangout-automator.service
      Wants=network-online.target

      [Service]
      Type=simple
      User=cloudflared
      Group=cloudflared
      EnvironmentFile=/etc/cloudflared/token.env
      ExecStart=/usr/bin/cloudflared tunnel run --token $${TUNNEL_TOKEN}
      Restart=always
      RestartSec=5
      UMask=0077
      NoNewPrivileges=true
      ProtectHome=true
      PrivateTmp=true
      StateDirectory=cloudflared

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/bin/hangout-bootstrap.sh
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail

      APP_DIR=/opt/hangout-automator
      DATA_DIR=/var/lib/hangout-automator
      DATA_DEVICE=/dev/disk/azure/scsi1/lun0

      # The data disk is attached by Terraform immediately after the VM. Wait
      # for udev so VM replacement does not erase the audit logs it carries.
      for _attempt in $(seq 1 60); do
        if [ -b "$DATA_DEVICE" ]; then
          break
        fi
        sleep 5
      done
      if [ ! -b "$DATA_DEVICE" ]; then
        echo "Persistent data disk $DATA_DEVICE did not appear" >&2
        exit 1
      fi

      if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
        mkfs.ext4 -F "$DATA_DEVICE"
      fi
      mkdir -p "$DATA_DIR"
      DATA_UUID=$(blkid -s UUID -o value "$DATA_DEVICE")
      if ! grep -q "UUID=$${DATA_UUID} $${DATA_DIR} " /etc/fstab; then
        printf 'UUID=%s %s ext4 defaults,nofail 0 2\n' "$DATA_UUID" "$DATA_DIR" >> /etc/fstab
      fi
      if ! mountpoint -q "$DATA_DIR"; then
        mount "$DATA_DIR"
      fi
      chown ${admin_username}:${admin_username} "$DATA_DIR"

      if [ ! -d "$APP_DIR/.git" ]; then
        if [ -z "${git_repo_url}" ]; then
          echo "git_repo_url is required for deterministic Terraform bootstrap" >&2
          exit 1
        fi
        git clone --branch "${git_branch}" "${git_repo_url}" "$APP_DIR"
      fi
      cd "$APP_DIR"
      if [ -n "${git_revision}" ]; then
        git fetch --all --prune
        git checkout --detach "${git_revision}"
      elif [ -d "$APP_DIR/.git" ]; then
        git fetch --all --prune
        git checkout "${git_branch}"
        git pull --ff-only origin "${git_branch}"
      fi

      if [ ! -f "$APP_DIR/requirements.txt" ]; then
        echo "requirements.txt is missing from $APP_DIR" >&2
        exit 1
      fi
      cd "$APP_DIR"
      python3 -m venv .venv
      .venv/bin/pip install --upgrade pip
      .venv/bin/pip install -r requirements.txt
      chown -R ${admin_username}:${admin_username} "$APP_DIR"

      # Schema migrations are a deploy step, never an app startup step. Run
      # them before the service starts, with the deployment's environment.
      set -a
      # shellcheck disable=SC1091
      . /etc/hangout-automator.env
      set +a
      .venv/bin/alembic upgrade head

      systemctl daemon-reload
      systemctl enable hangout-automator
      systemctl restart hangout-automator
      systemctl enable --now hangout-worker
      systemctl restart hangout-worker

runcmd:
  - install -d -m 0755 /usr/share/keyrings /etc/cloudflared
  - curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg -o /usr/share/keyrings/cloudflare-main.gpg
  - /bin/sh -c 'echo "deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared $(. /etc/os-release && echo $VERSION_CODENAME) main" > /etc/apt/sources.list.d/cloudflared.list'
  - apt-get -o DPkg::Lock::Timeout=300 update
  - DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 install -y cloudflared
  - getent group cloudflared >/dev/null 2>&1 || groupadd --system cloudflared
  - getent passwd cloudflared >/dev/null 2>&1 || useradd --system --gid cloudflared --home-dir /var/lib/cloudflared --create-home --shell /usr/sbin/nologin cloudflared
  - /usr/local/bin/hangout-bootstrap.sh
  - systemctl daemon-reload
  - systemctl enable --now cloudflared
